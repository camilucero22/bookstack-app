rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Acceso al espacio compartido
    function sharedAccess(workspaceId) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == "anonymous"
        && workspaceId == "libreria";
    }

    // Libros compartidos
    match /shared/{workspaceId}/books/{id} {
      allow read, delete: if sharedAccess(workspaceId);

      allow create, update: if sharedAccess(workspaceId)
        && request.resource.data.title is string
        && request.resource.data.price is number
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && (
          (
            request.resource.data.price > 0
            && request.resource.data.get("needsPricing", false) == false
          )
          ||
          (
            request.resource.data.price == 0
            && request.resource.data.get("needsPricing", false) == true
          )
        );
    }

    // Ventas compartidas
    match /shared/{workspaceId}/sales/{id} {
      allow read, create: if sharedAccess(workspaceId);
    }

    // Encargos de clientes
    match /shared/{workspaceId}/customerOrders/{id} {
      allow read, create, update, delete: if sharedAccess(workspaceId);
    }

    // Proveedores compartidos
    match /shared/{workspaceId}/suppliers/{id} {
      allow read, create, update, delete: if sharedAccess(workspaceId);
    }

    // Pedidos a proveedores
    match /shared/{workspaceId}/supplierOrders/{id} {
      allow read, create, update: if sharedAccess(workspaceId);
    }

    // Reglas anteriores: conservar durante la transición
    function mine(uid) {
      return request.auth != null
        && request.auth.uid == uid;
    }

    // Libros personales
    match /users/{uid}/books/{id} {
      allow read, delete: if mine(uid);

      allow create, update: if mine(uid)
        && request.resource.data.title is string
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0;
    }

    // Ventas personales
    match /users/{uid}/sales/{id} {
      allow read, create: if mine(uid);
    }

    // Encargos personales
    match /users/{uid}/customerOrders/{id} {
      allow read, create, update, delete: if mine(uid);
    }

    // Proveedores personales
    match /users/{uid}/suppliers/{id} {
      allow read, create, update, delete: if mine(uid);
    }

    // Pedidos a proveedores personales
    match /users/{uid}/supplierOrders/{id} {
      allow read, create, update: if mine(uid);
    }
  }
}
